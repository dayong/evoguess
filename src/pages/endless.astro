---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvoGame from '../components/EvoGame.astro';
import { CATEGORIES, PUZZLES } from '../data/puzzles';
import { UI_STRINGS } from '../i18n/translations';

const en = UI_STRINGS.en;
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://evoguess.site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'EvoGuess Endless Mode',
    url: `${siteOrigin}/endless/`,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    genre: 'Educational Trivia & Biology Puzzle',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Play EvoGuess Endless Mode — an unlimited evolutionary tree survival quiz. Keep your streak alive across mammals, dinosaurs, marine life, fungi, and more.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does EvoGuess Endless Mode work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Endless Mode shuffles every species matchup across the entire EvoGuess Tree of Life pool. Each correct guess extends your streak; a single wrong guess triggers an extinction event and ends the run.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my Endless best streak saved?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Your all-time Endless best streak is saved locally in your browser with no account required, and syncs across the Endless and Daily pages.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title="EvoGuess Endless Mode — Unlimited Evolutionary Tree Streak Quiz"
  description="Play unlimited evolutionary biology trivia in EvoGuess Endless Mode. Guess which species share a more recent common ancestor and push your survival streak across the entire Tree of Life."
  canonicalPath="/endless/"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-4 pt-7 pb-10 sm:pt-10">
    <div class="mb-4 text-center">
      <a
        href="/"
        class="inline-flex items-center text-xs font-semibold text-forest-700 hover:underline"
        data-i18n="vsBackHome"
      >
        {en.vsBackHome}
      </a>
    </div>

    <div class="mx-auto max-w-2xl text-center mb-6">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900"
      >
        <span aria-hidden="true">🔥</span>
        <span data-i18n="endlessBadge">{en.endlessBadge}</span>
      </span>
      <h1
        class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-forest-900"
        style="font-family: var(--font-display);"
        data-i18n="endlessTitle"
      >
        {en.endlessTitle}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-slate-600" data-i18n="endlessSubtitle">
        {en.endlessSubtitle}
      </p>
    </div>

    <EvoGame puzzles={PUZZLES} mode="endless" salt="evoguess-endless" />

    <!-- Endless Mode Rules & Quick Links -->
    <div class="mx-auto mt-12 max-w-4xl rounded-3xl border border-forest-200/80 bg-white p-6 sm:p-8">
      <h2
        class="text-xl font-bold text-forest-900"
        style="font-family: var(--font-display);"
        data-en="How Endless Survival Works"
        data-zh="无尽生存模式规则"
      >
        How Endless Survival Works
      </h2>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-2xl bg-amber-50/70 p-4 border border-amber-200/70">
          <h3
            class="font-bold text-sm text-amber-950"
            data-en="☄️ Sudden-Death Streak"
            data-zh="☄️ 一次失误即结束"
          >
            ☄️ Sudden-Death Streak
          </h3>
          <p
            class="mt-1.5 text-xs leading-relaxed text-slate-700"
            data-en="Every correct answer adds +1 to your run. Fall for a single convergent evolution trap and your lineage goes extinct."
            data-zh="每答对 1 题连胜 +1；只要掉进一次趋同进化陷阱，本轮就会触发“物种大灭绝”并结算成绩。"
          >
            Every correct answer adds +1 to your run. Fall for a single convergent evolution trap and your lineage goes extinct.
          </p>
        </div>

        <div class="rounded-2xl bg-forest-50/60 p-4 border border-forest-100">
          <h3
            class="font-bold text-sm text-forest-900"
            data-en="🌍 Full Tree of Life Pool"
            data-zh="🌍 全题库随机洗牌"
          >
            🌍 Full Tree of Life Pool
          </h3>
          <p
            class="mt-1.5 text-xs leading-relaxed text-slate-600"
            data-en={`Draws randomly from all ${PUZZLES.length} curated matchups across mammals, marine life, dinosaurs, birds, fungi, and invertebrates.`}
            data-zh={`从全部 ${PUZZLES.length} 道精选进化谜题中随机抽题，横跨哺乳动物、海洋生物、恐龙鸟类与真菌植物。`}
          >
            Draws randomly from all {PUZZLES.length} curated matchups across mammals, marine life, dinosaurs, birds, fungi, and invertebrates.
          </p>
        </div>

        <div class="rounded-2xl bg-forest-50/60 p-4 border border-forest-100">
          <h3
            class="font-bold text-sm text-forest-900"
            data-en="🏆 Local Best Record"
            data-zh="🏆 自动保存最高纪录"
          >
            🏆 Local Best Record
          </h3>
          <p
            class="mt-1.5 text-xs leading-relaxed text-slate-600"
            data-en="Your personal high score is stored automatically in your browser and can be shared as an emoji streak scorecard."
            data-zh="无需登录，浏览器会自动记录你的历史最高连胜，结算后可一键复制 Emoji 战绩卡分享给好友。"
          >
            Your personal high score is stored automatically in your browser and can be shared as an emoji streak scorecard.
          </p>
        </div>
      </div>

      <!-- Explore other modes -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-5 text-xs font-semibold">
        <div class="flex flex-wrap gap-2">
          {
            CATEGORIES.map((cat) => (
              <a
                href={`/mode/${cat.slug}/`}
                class="inline-flex items-center gap-1.5 rounded-full border border-forest-200 bg-forest-50/60 px-3 py-1.5 text-forest-800 transition hover:border-forest-500 hover:bg-forest-100"
              >
                <span aria-hidden="true">{cat.emoji}</span>
                <span data-en={cat.shortTitle.en} data-zh={cat.shortTitle.zh}>
                  {cat.shortTitle.en}
                </span>
              </a>
            ))
          }
        </div>
        <div class="flex flex-wrap gap-4 text-forest-700">
          <a href="/matchups/" class="hover:underline" data-i18n="viewAllMatchupsCta">
            {en.viewAllMatchupsCta}
          </a>
          <a href="/guide/" class="hover:underline" data-i18n="readGuideCta">
            {en.readGuideCta}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
